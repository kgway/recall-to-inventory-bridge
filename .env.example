# Copy to .env. Never commit .env or paste keys into chat.
# Use a dedicated Gemini Free Tier project with NO linked billing account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FREE_TIER_CONFIRMED=false
# First visit: no-key recorded demo. Opt into live only in a separate empty instance.
AGENT_MODE=disabled
MAX_AGENT_ROUNDS=4
MAX_AGENT_RUNS_PER_DAY=5
IRIS_IMAGE=recall-guard-aihub:2027.1.0AI.109.0
IRIS_PASSWORD=
